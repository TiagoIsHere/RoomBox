{
  "name": "roombox-desktop",
  "private": true,
  "version": "3.5.0",
  "description": "RoomBox — Native Electron File Manager with PS1 Anime Bedroomcore UI, Virtualized 60fps Lists, Git Status, Symlinks & Vim Motions",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json && wait-on http://localhost:5173 && electron dist-electron/main.js\"",
    "dev:web": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "start": "tsc -p tsconfig.electron.json && electron dist-electron/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.8",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.1"
  }
}
